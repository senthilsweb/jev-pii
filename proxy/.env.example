# Copy to .env (git-ignored) and fill in. docker compose reads it via env_file.

# Optional: let the proxy hold your TypeSafe key so callers need not send one.
# It is ONLY used for requests that also send the header  X-Proxy-Secret: <PROXY_SECRET>,
# and a caller's own  Authorization: Bearer <key>  header always overrides it.
# Leave both empty to run keyless (every caller brings their own key).
TYPESAFE_API_KEY=
PROXY_SECRET=              # 16+ characters, e.g.  openssl rand -hex 24

# Optional "no credentials needed" mode. OFF by default: when on, ANYONE who can reach the proxy and sends no key
# and no secret is served with TYPESAFE_API_KEY, i.e. spends your quota. Bounded by the two limits below, which are
# per instance and in memory (a restart or scale-to-zero resets the daily count).
OPEN_SERVER_KEY=0
OPEN_RATE_PER_MIN=20       # per client, keyless callers only
OPEN_DAILY_MAX=1000        # total keyless calls per UTC day

ALLOWED_ORIGINS=https://www.senthilsweb.com
RATE_PER_MIN=120
TRUST_PROXY=1
